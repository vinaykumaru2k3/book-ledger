# Copy to `.env.local` and fill in the values from
# Firebase console > Project settings > Your apps > Web app.
# Leave everything unset to use the default hosted project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: a Google Books API key (Google Cloud console > APIs & Services >
# Credentials), restricted to your site. Gives book search and cover lookups
# their own 1,000-a-day quota instead of the shared keyless one.
VITE_GOOGLE_BOOKS_API_KEY=
